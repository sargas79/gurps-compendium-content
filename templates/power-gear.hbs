{{!-- The character's gear that runs on cells, and what is left in each
     (Ultra-Tech pp. 18-19), in the words of the first book whose cell table
     applies (`ns`). --}}
<section class="card" data-gcc-power-gear>
  <div class="card-head"><h3>{{localize (concat @root.ns ".Power.GearTitle")}}</h3></div>
  <table class="gtable">
    <thead>
      <tr>
        <th>{{localize (concat @root.ns ".Power.Item")}}</th>
        <th>{{localize (concat @root.ns ".Power.Cells")}}</th>
        <th>{{localize (concat @root.ns ".Power.Charge")}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each rows as |r|}}
        <tr data-item-id="{{r.id}}">
          <td>{{r.name}}</td>
          <td>{{r.supply}}</td>
          <td>
            {{r.charge}}
            {{#if r.tracksHours}}
              <label data-tooltip="{{localize (concat @root.ns ".Power.UsedHint")}}">{{localize (concat @root.ns ".Power.Used")}}
                <input type="number" data-gcc-power-used value="{{r.hoursUsed}}" step="0.5" min="0" style="width:60px" {{#unless ../editable}}disabled{{/unless}} />
              </label>
            {{/if}}
            {{#if r.tracksUses}}
              <label data-tooltip="{{localize (concat @root.ns ".Power.UsesHint")}}">{{localize (concat @root.ns ".Power.UsesUsed")}}
                <input type="number" data-gcc-power-uses value="{{r.usesUsed}}" step="1" min="0" style="width:50px" {{#unless ../editable}}disabled{{/unless}} />
              </label>
            {{/if}}
          </td>
          <td>
            {{#if r.cosmic}}
            {{else if r.weapon}}
              <span class="ihint" data-tooltip="{{localize (concat @root.ns ".Power.WeaponHint")}}">{{localize (concat @root.ns ".Power.ReloadOnCombat")}}</span>
            {{else}}
              <button type="button" class="ibtn tiny" data-gcc-power-change {{#unless ../editable}}disabled{{/unless}}>{{localize (concat @root.ns ".Power.Change")}}</button>
            {{/if}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>
