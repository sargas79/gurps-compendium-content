{{!-- The character's gear that runs on cells, and what is left in each
     (Ultra-Tech pp. 18-19). --}}
<section class="card" data-gcc-ut-power-gear>
  <div class="card-head"><h3>{{localize "GCC.UT.Power.GearTitle"}}</h3></div>
  <table class="gtable">
    <thead>
      <tr>
        <th>{{localize "GCC.UT.Power.Item"}}</th>
        <th>{{localize "GCC.UT.Power.Cells"}}</th>
        <th>{{localize "GCC.UT.Power.Charge"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each rows as |r|}}
        <tr data-item-id="{{r.id}}">
          <td>{{r.name}}</td>
          <td>{{r.supply}}</td>
          <td>
            {{r.charge}}
            {{#if r.tracksHours}}
              <label data-tooltip="{{localize 'GCC.UT.Power.UsedHint'}}">{{localize "GCC.UT.Power.Used"}}
                <input type="number" data-gcc-ut-used value="{{r.hoursUsed}}" step="0.5" min="0" style="width:60px" {{#unless ../editable}}disabled{{/unless}} />
              </label>
            {{/if}}
          </td>
          <td>
            {{#if r.cosmic}}
            {{else if r.weapon}}
              <span class="ihint" data-tooltip="{{localize 'GCC.UT.Power.WeaponHint'}}">{{localize "GCC.UT.Power.ReloadOnCombat"}}</span>
            {{else}}
              <button type="button" class="ibtn tiny" data-gcc-ut-change {{#unless ../editable}}disabled{{/unless}}>{{localize "GCC.UT.Power.Change"}}</button>
            {{/if}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>
