{{!-- An unstable or home-made explosive (High-Tech pp. 184-187): the 3d roll a jolt sets it off on, and what a home-made batch came out as. --}}
<div class="isub" data-gcc-ht-explosives-section>
  <div class="isub-head">{{localize "GCC.HT.Rules.unstableExplosives.Name"}}</div>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.HT.Explosives.ShockOnHint'}}">{{localize "GCC.HT.Explosives.ShockOn"}}
      <input type="number" min="0" max="18" step="1" name="{{field}}.shockOn" value="{{shockOn}}" {{#unless editable}}disabled{{/unless}} />
    </label>
    <label data-tooltip="{{localize 'GCC.HT.Explosives.HomeMadeHint'}}">{{localize "GCC.HT.Explosives.HomeMade"}}
      <select name="{{field}}.homeMade" {{#unless editable}}disabled{{/unless}}>
        {{#each flaws as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
      </select>
    </label>
  </div>
  <p class="ihint">{{line}}</p>
</div>
