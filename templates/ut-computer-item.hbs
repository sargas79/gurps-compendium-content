{{!-- A computer's model and options, or a program's Complexity
     (Ultra-Tech pp. 21-25). --}}
<div class="isub" data-gcc-ut-computer-section>
  <div class="isub-head">{{localize "GCC.UT.Computer.Title"}}</div>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.UT.Computer.KindHint'}}">{{localize "GCC.UT.Computer.KindLabel"}}
      <select data-gcc-ut-computer="kind" {{#unless editable}}disabled{{/unless}}>
        {{#each kinds as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
      </select>
    </label>
    {{#if isComputer}}
      <label data-tooltip="{{localize 'GCC.UT.Computer.ModelHint'}}">{{localize "GCC.UT.Computer.ModelLabel"}}
        <select data-gcc-ut-computer="model" {{#unless editable}}disabled{{/unless}}>
          {{#each models as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        </select>
      </label>
      <label data-tooltip="{{localize 'GCC.UT.Computer.ExtraStorageHint'}}">{{localize "GCC.UT.Computer.ExtraStorageLabel"}}
        <input type="number" data-gcc-ut-computer="extraStorage" value="{{data.extraStorage}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} />
      </label>
    {{/if}}
    {{#if isProgram}}
      <label data-tooltip="{{localize 'GCC.UT.Computer.ComplexityHint'}}">{{localize "GCC.UT.Computer.ComplexityLabel"}}
        <input type="number" data-gcc-ut-computer="complexity" value="{{data.complexity}}" step="1" min="1" max="20" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label data-tooltip="{{localize 'GCC.UT.Computer.DifficultyHint'}}">{{localize "GCC.UT.Computer.DifficultyLabel"}}
        <select data-gcc-ut-computer="difficulty" {{#unless editable}}disabled{{/unless}}>
          {{#each difficulties as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.value}}</option>{{/each}}
        </select>
      </label>
      {{#if carried}}
        <label data-tooltip="{{localize 'GCC.UT.Computer.RunsOnHint'}}">{{localize "GCC.UT.Computer.RunsOnLabel"}}
          <select data-gcc-ut-computer="runsOn" {{#unless editable}}disabled{{/unless}}>
            {{#each computers as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
          </select>
        </label>
      {{/if}}
    {{/if}}
  </div>

  {{#if isComputer}}
    <div class="ichecks">
      {{#each options as |o|}}
        <label class="icheck" data-tooltip="{{o.hint}}"><input type="checkbox" data-gcc-ut-computer="options.{{o.value}}" {{#if o.checked}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}} /> {{o.label}}{{#if o.conflict}} ({{localize "GCC.UT.Computer.Excluded"}}){{/if}}</label>
      {{/each}}
    </div>
    <p class="ihint">{{figures}}</p>
    {{#if lc}}<p class="ihint">{{lc}}</p>{{/if}}
    {{#if cells}}<p class="ihint">{{cells}}</p>{{/if}}
    {{#if hardened}}<p class="ihint">{{hardened}}</p>{{/if}}
    <p class="ihint">{{ai}}</p>
  {{/if}}

  {{#if isProgram}}
    <div class="ichecks">
      <label class="icheck" data-tooltip="{{localize 'GCC.UT.Computer.MassMarketHint'}}"><input type="checkbox" data-gcc-ut-computer="massMarket" {{#if data.massMarket}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Computer.MassMarket"}}</label>
    </div>
    <p class="ihint">{{price}}</p>
    {{#if tool}}
      <p class="ihint">{{tool}}
        {{#if toolMismatch}}<button type="button" class="ibtn tiny" data-gcc-ut-computer-quality {{#unless editable}}disabled{{/unless}}>{{localize "GCC.UT.Computer.SetQuality"}}</button>{{/if}}
      </p>
    {{/if}}
  {{/if}}
</div>
