{{!-- The character's computers, what each runs, and the AIs each could hold
     (Ultra-Tech pp. 22, 25). --}}
<section class="card" data-gcc-ut-computer-gear>
  <div class="card-head"><h3>{{localize "GCC.UT.Computer.GearTitle"}}</h3></div>
  <table class="gtable">
    <thead>
      <tr>
        <th>{{localize "GCC.UT.Computer.Computer"}}</th>
        <th>{{localize "GCC.UT.Computer.ComplexityShortHead"}}</th>
        <th>{{localize "GCC.UT.Computer.Storage"}}</th>
        <th>{{localize "GCC.UT.Computer.Programs"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows as |r|}}
        <tr data-item-id="{{r.id}}">
          <td data-tooltip="{{r.ai}}">{{r.name}}</td>
          <td>{{r.complexity}}</td>
          <td>{{r.storage}}</td>
          <td>
            {{#each r.programs as |p|}}<span {{#if p.tooComplex}}class="gc-bad" data-tooltip="{{localize 'GCC.UT.Computer.TooComplex'}}"{{/if}}>{{p.name}} ({{p.complexity}})</span>{{#unless @last}}, {{/unless}}{{/each}}
            {{#if r.programs.length}}
              · {{#if r.overloaded}}<strong data-tooltip="{{localize 'GCC.UT.Computer.OverloadedHint'}}">{{localize "GCC.UT.Computer.Overloaded"}}</strong>{{else}}{{r.load}}%{{/if}}
            {{/if}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>
