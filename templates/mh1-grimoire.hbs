{{!-- A grimoire (Monster Hunters 1 pp. 39, 56-57): the rituals it teaches,
     each with its bonus, and what it takes to read. On a character, a ritual
     is chosen from theirs and remembered as it is defined now. --}}
<div class="isub">
  <div class="isub-head">
    {{localize "GCC.MH1.Grimoire.Title"}}
    {{#if editable}}<button type="button" class="ibtn" data-gcc-grimoire-add>+ {{localize "GCC.MH1.Ritual.AddEntry"}}</button>{{/if}}
  </div>
  {{#each entries as |e|}}
    <div class="irow">
      {{#if @root.onCharacter}}
        <select data-gcc-grimoire-ritual data-index="{{e.index}}" aria-label="{{localize 'GCC.MH1.Ritual.Title'}}" {{#unless @root.editable}}disabled{{/unless}}>
          <option value="" {{#unless e.ritual}}selected{{/unless}}>—</option>
          {{#each e.options as |o|}}<option value="{{o.name}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>{{/each}}
          {{#if e.missing}}<option value="{{e.ritual}}" selected>{{e.ritual}}</option>{{/if}}
        </select>
      {{else}}
        <input type="text" data-gcc-grimoire-ritual data-index="{{e.index}}" value="{{e.ritual}}" placeholder="{{localize 'GCC.MH1.Ritual.Title'}}" {{#unless @root.editable}}disabled{{/unless}} />
      {{/if}}
      <input type="number" data-gcc-grimoire-bonus data-index="{{e.index}}" value="{{e.bonus}}" min="0" max="10" step="1"
             aria-label="{{localize 'GCC.MH1.Ritual.Column.Bonus'}}" style="width: 56px" {{#unless @root.editable}}disabled{{/unless}} />
      {{#if e.changed}}<span class="tag tag-danger" data-tooltip="{{localize 'GCC.MH1.Grimoire.ChangedHint'}}">{{localize "GCC.MH1.Grimoire.Changed"}}</span>{{/if}}
      {{#if @root.editable}}
        <button type="button" class="rollable iconbtn" data-gcc-grimoire-delete data-index="{{e.index}}" title="{{localize 'GCC.MH1.Ritual.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      {{/if}}
    </div>
  {{/each}}
  {{#if entries.length}}
    <div class="ifields">
      <label data-tooltip="{{localize 'GCC.MH1.Grimoire.DeadLanguageHint'}}">{{localize "GCC.MH1.Grimoire.DeadLanguage"}}
        <input type="text" data-gcc-grimoire-language value="{{g.deadLanguage}}" placeholder="—" {{#unless editable}}disabled{{/unless}} />
      </label>
      {{#if g.deadLanguage}}
        <label>{{localize "GCC.MH1.Grimoire.Translation"}}
          <select data-gcc-grimoire-translation {{#unless editable}}disabled{{/unless}}>
            {{#each translations as |t|}}<option value="{{t.value}}" {{#if t.selected}}selected{{/if}}>{{t.label}}</option>{{/each}}
          </select>
        </label>
      {{/if}}
    </div>
    <div class="ichecks">
      <label class="icheck"><input type="checkbox" data-gcc-grimoire-encrypted {{#if g.encrypted}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.MH1.Grimoire.Encrypted"}}</label>
      {{#if g.encrypted}}
        <label class="icheck"><input type="checkbox" data-gcc-grimoire-decoded {{#if g.decoded}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.MH1.Grimoire.Decoded"}}</label>
      {{/if}}
    </div>
    {{#if price}}<p class="ihint">{{price}}</p>{{/if}}
  {{else}}
    <p class="ihint">{{localize "GCC.MH1.Grimoire.Hint"}}</p>
  {{/if}}
</div>
