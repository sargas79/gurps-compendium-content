{{!-- High-Tech's "You shot me, Mister!" (p. 162): the Fright Check a serious wound calls for. --}}
<div class="gc-head"><span class="gc-label">{{title}}</span></div>
<div class="gc-result">{{text}}</div>
{{#unless rolled}}<div class="gc-apply"><button type="button" class="gc-apply-button" data-addon-card-action="roll">{{button}}</button></div>{{/unless}}
