{{!-- Unfamiliar weapons (Martial Arts p. 212): the group a weapon belongs to. --}}
<div class="isub" data-ma-weapon-group-section>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.MA.Unorthodox.GroupHint'}}">{{localize "GCC.MA.Unorthodox.GroupLabel"}}
      <input type="text" data-ma-weapon-group value="{{value}}" {{#unless editable}}disabled{{/unless}} />
    </label>
  </div>
</div>
