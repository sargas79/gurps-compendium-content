{{!-- Breathing gear and environment suits (High-Tech pp. 72-76). --}}
<div class="isub" data-gcc-ht-breathing-section>
  <div class="isub-head">{{localize "GCC.HT.Breathing.Title"}}</div>
  {{#if supply}}
    <div class="ifields">
      <label data-tooltip="{{localize 'GCC.HT.Breathing.DepthHint'}}">{{localize "GCC.HT.Breathing.DepthFeet"}}
        <input type="number" min="0" step="1" data-gcc-ht-dive-depth value="{{depthFeet}}" {{#unless editable}}disabled{{/unless}} />
      </label>
    </div>
  {{/if}}
  {{#if turnout}}
    <div class="ichecks">
      <label class="icheck" data-tooltip="{{localize 'GCC.HT.Breathing.WetHint'}}"><input type="checkbox" data-gcc-ht-turnout-wet {{#if wet}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.HT.Breathing.Wet"}}</label>
    </div>
  {{/if}}
  {{#if nbc}}
    <div class="ichecks">
      <label class="icheck" data-tooltip="{{localize 'GCC.HT.Breathing.NbcWetHint'}}"><input type="checkbox" data-gcc-ht-turnout-wet {{#if wet}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.HT.Breathing.NbcWet"}}</label>
    </div>
  {{/if}}
  {{#if fitted}}
    <div class="ichecks">
      <label class="icheck" data-tooltip="{{localize 'GCC.HT.Breathing.FittedHint'}}"><input type="checkbox" data-gcc-ht-climate-fitted {{#if fitted.checked}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.HT.Breathing.Fitted"}}</label>
    </div>
  {{/if}}
  {{#each lines as |line|}}<p class="ihint">{{line}}</p>{{/each}}
</div>
