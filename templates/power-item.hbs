{{!-- What powers the item, in the words of the book whose cell table applies
     (`ns`; Ultra-Tech pp. 18-20, 133; High-Tech pp. 13-14): the cell its table
     line gives, the kind loaded, rigging it to smaller cells or swapping them
     for another size, adapters and inverters, and what the cells do if they
     explode. `inverterOnly` is gear with no cells that an inverter could run
     on them. --}}
<div class="isub" data-gcc-power-section>
  <div class="isub-head">{{localize (concat ns ".Power.Title")}}</div>
  {{#if inverterOnly}}
    <div class="ichecks">
      <label class="icheck" data-tooltip="{{localize (concat ns ".Power.InverterHint")}}"><input type="checkbox" data-gcc-power="inverter" {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Inverter")}}</label>
    </div>
  {{else}}
  <p class="ihint">{{supply}}{{#if endurance}} · {{endurance}}{{/if}}</p>

  <div class="ichecks">
    {{#if kinds.flexible}}
      <label class="icheck" data-tooltip="{{localize (concat ns ".Power.FlexibleHint")}}"><input type="checkbox" data-gcc-power="flexible" {{#if data.flexible}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Flexible")}}</label>
    {{/if}}
    {{#if kinds.nonRechargeable}}
      <label class="icheck" data-tooltip="{{localize (concat ns ".Power.NonRechargeableHint")}}"><input type="checkbox" data-gcc-power="nonRechargeable" {{#if data.nonRechargeable}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.NonRechargeable")}}</label>
    {{/if}}
    {{#if kinds.rechargeable}}
      <label class="icheck" data-tooltip="{{localize (concat ns ".Power.RechargeableHint")}}"><input type="checkbox" data-gcc-power="rechargeable" {{#if data.rechargeable}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Rechargeable")}}</label>
    {{/if}}
    {{#if kinds.cosmic}}
      <label class="icheck" data-tooltip="{{localize (concat ns ".Power.CosmicHint")}}"><input type="checkbox" data-gcc-power="cosmic" {{#if data.cosmic}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Cosmic")}}</label>
    {{/if}}
    {{#if kinds.superscience}}
      <label class="icheck" data-tooltip="{{localize (concat ns ".Power.SuperscienceHint")}}"><input type="checkbox" data-gcc-power="superscience" {{#if data.superscience}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Superscience")}}</label>
    {{/if}}
    {{#if adapters}}
      {{#if data.inverter}}
        <label class="icheck" data-tooltip="{{localize (concat ns ".Power.InverterHint")}}"><input type="checkbox" data-gcc-power="inverter" checked {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Inverter")}}</label>
      {{else}}
        <label class="icheck" data-tooltip="{{localize (concat ns ".Power.AdapterHint")}}"><input type="checkbox" data-gcc-power="adapter" {{#if data.adapter}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize (concat ns ".Power.Adapter")}}</label>
      {{/if}}
    {{/if}}
  </div>
  {{#if tlField}}
    <div class="ifields">
      <label data-tooltip="{{localize (concat ns ".Power.TlHint")}}">{{localize (concat ns ".Power.Tl")}}
        <input type="number" data-gcc-power="tl" value="{{data.tl}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} />
      </label>
    </div>
  {{/if}}
  {{#if data.inverter}}
    <div class="ifields">
      <label data-tooltip="{{localize (concat ns ".Power.InverterEnduranceHint")}}">{{localize (concat ns ".Power.InverterEndurance")}}
        <input type="text" data-gcc-power-endurance value="{{inverterEndurance}}" placeholder="8 hrs." style="width:90px" {{#unless editable}}disabled{{/unless}} />
      </label>
    </div>
  {{/if}}
  {{#if swap}}
    <div class="ifields" data-tooltip="{{localize (concat ns ".Power.SwapHint")}}">
      <label>{{localize (concat ns ".Power.Swap")}}
        <input type="number" data-gcc-power-swap-cells value="{{swap.cells}}" step="1" min="1" {{#unless editable}}disabled{{/unless}} />
      </label>
      <label>{{localize (concat ns ".Power.SwapSize")}}
        <select data-gcc-power-swap {{#unless editable}}disabled{{/unless}}>
          {{#each swap.sizes as |s|}}<option value="{{s.size}}" {{#if s.selected}}selected{{/if}}>{{s.size}}</option>{{/each}}
        </select>
      </label>
    </div>
    <p class="ihint">{{localize (concat ns ".Power.SwapUsual")}} {{swap.usual}}</p>
  {{/if}}

  {{#if price}}<p class="ihint">{{price}}</p>{{/if}}
  {{#if shots}}<p class="ihint">{{shots}}</p>{{/if}}
  {{#if blast}}<p class="ihint" data-tooltip="{{localize (concat ns ".Power.BlastHint")}}">{{blast}}</p>{{/if}}

  {{#if smaller.length}}
    <div class="ifields" data-tooltip="{{localize (concat ns ".Power.RigHint")}}">
      <span>{{localize (concat ns ".Power.Rig")}}</span>
      {{#each smaller as |s|}}
        <button type="button" class="ibtn tiny" data-gcc-power-rig="{{s.size}}" {{#unless ../editable}}disabled{{/unless}}>{{s.cells}} × {{s.size}}</button>
      {{/each}}
    </div>
  {{/if}}
  {{/if}}
</div>
