{{!-- Unfamiliar weapons (Martial Arts p. 212): the weapon groups a fighter knows. --}}
<div class="isec" data-ma-familiar-weapons>
  <div class="ish">{{localize "GCC.MA.Unorthodox.FamiliarTitle"}}</div>
  <label class="ifield" data-tooltip="{{localize 'GCC.MA.Unorthodox.FamiliarHint'}}">
    <input type="text" name="{{field}}" value="{{value}}" placeholder="{{localize 'GCC.MA.Unorthodox.FamiliarPlaceholder'}}" {{#unless editable}}disabled{{/unless}} />
  </label>
</div>
