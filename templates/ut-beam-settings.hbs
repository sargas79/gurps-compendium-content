{{!-- A neural or mind disruptor's settings (Ultra-Tech pp. 121-122, 132): the
     ones it was built with, which reprice it, and the one it is on. --}}
<div class="isub" data-gcc-ut-beam-settings>
  <div class="isub-head">{{localize "GCC.UT.Neural.Title"}}</div>
  <div class="ichecks">
    {{#each settings as |s|}}
      <label class="icheck"><input type="checkbox" data-gcc-ut-built="{{s.value}}" {{#if s.built}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}} /> {{s.label}}</label>
    {{/each}}
  </div>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.UT.Neural.SettingHintLabel'}}">{{localize "GCC.UT.Neural.SettingLabel"}}
      <select data-gcc-ut-setting {{#unless editable}}disabled{{/unless}}>
        {{#each settings as |s|}}{{#if s.built}}<option value="{{s.value}}" {{#if s.active}}selected{{/if}}>{{s.label}}</option>{{/if}}{{/each}}
      </select>
    </label>
  </div>
  <p class="ihint">{{cost}}</p>
</div>
