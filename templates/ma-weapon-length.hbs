{{!-- A Matter of Inches (Martial Arts p. 110): where the weapon sits on the length scale. --}}
<div class="isub" data-ma-weapon-length-section>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.MA.Timing.LengthHint'}}">{{localize "GCC.MA.Timing.LengthLabel"}}
      <select data-ma-weapon-length {{#unless editable}}disabled{{/unless}}>
        <option value="">{{byName}}</option>
        {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>
</div>
