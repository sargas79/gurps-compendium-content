{{!-- A conditional ritual set off (Monster Hunters 1 p. 38), with a button for
     the caster's player or the GM where it couldn't be started at once. --}}
<div class="gc-head"><span class="gc-label">{{name}}</span></div>
<div class="gc-result success">{{triggered}}</div>
{{#if lasts}}<div class="gc-note">{{lasts}}</div>{{/if}}
{{#if pending}}
  <div class="gc-note">{{waiting}}</div>
  <div class="gc-apply">
    <button type="button" class="gc-apply-button" data-addon-card-action="start">{{startLabel}}</button>
  </div>
{{/if}}
