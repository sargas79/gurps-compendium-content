{{!-- A broken glass lantern's fire (High-Tech p. 51; Molotov cocktail, p. 191; Campaigns p. 411): each second's damage, for the GM to apply to whoever stands in it. --}}
<div class="gc-head"><span class="gc-label">{{localize "GCC.HT.Expedition.FireTitle"}}</span></div>
<div class="gc-result">{{localize "GCC.HT.Expedition.FireCard" name=name yards=yards formula=formula divisor=divisor seconds=seconds}}</div>
<div class="gc-apply">
  <button type="button" class="gc-apply-button" data-addon-card-action="burn">{{localize "GCC.HT.Expedition.FireBurn" formula=formula}}</button>
</div>
