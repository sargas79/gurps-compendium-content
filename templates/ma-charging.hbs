{{!-- Charging foes (Martial Arts p. 106): an obstruction's strike, or a foe held at bay. --}}
<div class="gc-head"><span class="gc-label">{{title}}</span></div>
<div class="gc-result">{{text}}</div>
{{#each notes}}<div class="gc-note">{{this}}</div>{{/each}}
<div class="gc-apply">{{#each buttons}}<button type="button" class="gc-apply-button" data-addon-card-action="{{action}}">{{label}}</button>{{/each}}</div>
