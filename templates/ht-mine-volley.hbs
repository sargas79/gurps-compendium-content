{{!-- A directional mine's shotload, resolved nearest first (High-Tech p. 189). --}}
<div class="gc-head"><span class="gc-label">{{name}}</span></div>
<div class="gc-note">{{localize "GCC.HT.Ordnance.Mine.VolleyCard"}} {{left}} / {{pellets}}</div>
{{#each rows}}
  <div class="gc-result"><strong>{{this.name}}</strong>: {{this.summary}} &mdash; {{this.line}}</div>
  {{#if this.hits}}{{#unless this.rolled}}
    <div class="gc-apply">
      <button type="button" class="gc-apply-button" data-addon-card-action="damage" data-index="{{this.index}}">{{localize "GCC.HT.Ordnance.Mine.RollDamage"}} ({{this.name}})</button>
    </div>
  {{/unless}}{{/if}}
{{/each}}
