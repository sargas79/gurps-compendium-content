{{!-- What powers the item (Ultra-Tech pp. 18-20, 133): the cell its table line
     gives, the kind loaded, rigging it to smaller cells, and what the cells do
     if they explode. --}}
<div class="isub" data-gcc-ut-power-section>
  <div class="isub-head">{{localize "GCC.UT.Power.Title"}}</div>
  <p class="ihint">{{supply}}{{#if endurance}} · {{endurance}}{{/if}}</p>

  <div class="ichecks">
    <label class="icheck" data-tooltip="{{localize 'GCC.UT.Power.FlexibleHint'}}"><input type="checkbox" data-gcc-ut-power="flexible" {{#if data.flexible}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Power.Flexible"}}</label>
    <label class="icheck" data-tooltip="{{localize 'GCC.UT.Power.NonRechargeableHint'}}"><input type="checkbox" data-gcc-ut-power="nonRechargeable" {{#if data.nonRechargeable}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Power.NonRechargeable"}}</label>
    <label class="icheck" data-tooltip="{{localize 'GCC.UT.Power.CosmicHint'}}"><input type="checkbox" data-gcc-ut-power="cosmic" {{#if data.cosmic}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Power.Cosmic"}}</label>
    {{#if ranged}}
      <label class="icheck" data-tooltip="{{localize 'GCC.UT.Power.SuperscienceHint'}}"><input type="checkbox" data-gcc-ut-power="superscience" {{#if data.superscience}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Power.Superscience"}}</label>
    {{/if}}
  </div>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.UT.Power.TlHint'}}">{{localize "GCC.UT.Power.Tl"}}
      <input type="number" data-gcc-ut-power="tl" value="{{data.tl}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} />
    </label>
  </div>

  {{#if price}}<p class="ihint">{{price}}</p>{{/if}}
  {{#if shots}}<p class="ihint">{{shots}}</p>{{/if}}
  {{#if blast}}<p class="ihint" data-tooltip="{{localize 'GCC.UT.Power.BlastHint'}}">{{blast}}</p>{{/if}}

  {{#if smaller.length}}
    <div class="ifields" data-tooltip="{{localize 'GCC.UT.Power.RigHint'}}">
      <span>{{localize "GCC.UT.Power.Rig"}}</span>
      {{#each smaller as |s|}}
        <button type="button" class="ibtn tiny" data-gcc-ut-rig="{{s.size}}" {{#unless ../editable}}disabled{{/unless}}>{{s.cells}} × {{s.size}}</button>
      {{/each}}
    </div>
  {{/if}}
</div>
