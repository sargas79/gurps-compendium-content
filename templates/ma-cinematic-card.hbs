{{!-- Martial Arts' cinematic rules (pp. 130, 132-133): a Fright Check, shaking it off, Bullet Time. --}}
<div class="gc-head"><span class="gc-label">{{title}}</span></div>
<div class="gc-result">{{text}}</div>
{{#each notes}}<div class="gc-note">{{this}}</div>{{/each}}
{{#if buttons.length}}<div class="gc-apply">{{#each buttons}}<button type="button" class="gc-apply-button" data-addon-card-action="{{action}}">{{label}}</button>{{/each}}</div>{{/if}}
