{{!-- A homing weapon's own seeker (High-Tech: Electricity and Electronics p. 49). --}}
<div class="isub" data-gcc-ee-seeker-section>
  <div class="isub-head">{{localize "GCC.HT.Guidance.SeekerTitle"}}</div>
  <div class="ifields">
    <label data-tooltip="{{localize 'GCC.HT.Guidance.SeekerHint'}}">{{localize "GCC.HT.Guidance.Seeker"}}
      <select data-gcc-ee-seeker {{#unless editable}}disabled{{/unless}}>
        {{#each choices as |c|}}<option value="{{c.value}}" {{#if c.selected}}selected{{/if}}>{{c.label}}</option>{{/each}}
      </select>
    </label>
  </div>
</div>
