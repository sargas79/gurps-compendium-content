{{!-- A communicator's or sensor's figures by TL, and its options
     (Ultra-Tech pp. 43-46, 60-66). --}}
<div class="isub" data-gcc-ut-sensor-section>
  <div class="isub-head">{{localize "GCC.UT.Sensor.Title"}}</div>
  {{#if comm}}
    <div class="ifields">
      <label data-tooltip="{{localize 'GCC.UT.Sensor.CommModeHint'}}">{{localize "GCC.UT.Sensor.CommModeLabel"}}
        <select data-gcc-ut-sensor="commMode" {{#unless editable}}disabled{{/unless}}>
          {{#each modes as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        </select>
      </label>
    </div>
  {{/if}}
  {{#if active}}
    <div class="ichecks">
      <label class="icheck" data-tooltip="{{localize 'GCC.UT.Sensor.TacticalHint'}}"><input type="checkbox" data-gcc-ut-sensor="tactical" {{#if data.tactical}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Sensor.TacticalLabel"}}</label>
      <label class="icheck" data-tooltip="{{localize 'GCC.UT.Sensor.LpiHint'}}"><input type="checkbox" data-gcc-ut-sensor="lpi" {{#if data.lpi}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GCC.UT.Sensor.LpiLabel"}}</label>
    </div>
  {{/if}}
  {{#each lines as |line|}}<p class="ihint">{{line}}</p>{{/each}}
</div>
