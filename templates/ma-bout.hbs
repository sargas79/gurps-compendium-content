{{!-- Tournament combat's detailed method (Martial Arts p. 134): the GM's round clock. --}}
<div class="gc-head"><span class="gc-label">{{title}}</span></div>
<div class="gc-result">{{clock}}</div>
{{#each log}}<div class="gc-note">{{this}}</div>{{/each}}
<div class="gc-apply">
  {{#if between}}<button type="button" class="gc-apply-button" data-addon-card-action="startRound">{{localize "GCC.MA.Tournament.StartRound"}}</button>{{/if}}
  {{#if inRound}}<button type="button" class="gc-apply-button" data-addon-card-action="phaseOver">{{localize "GCC.MA.Tournament.PhaseOver"}}</button>{{/if}}
  {{#if inFlurry}}
    <button type="button" class="gc-apply-button" data-addon-card-action="pressFirst">{{firstName}} ⇢</button>
    <button type="button" class="gc-apply-button" data-addon-card-action="pressSecond">⇠ {{secondName}}</button>
    <button type="button" class="gc-apply-button" data-addon-card-action="pressBoth">{{localize "GCC.MA.Tournament.PressBoth"}}</button>
    <button type="button" class="gc-apply-button" data-addon-card-action="earlyLull">{{localize "GCC.MA.Tournament.EarlyLull"}}</button>
  {{/if}}
  {{#if inRound}}<button type="button" class="gc-apply-button" data-addon-card-action="endRound">{{localize "GCC.MA.Tournament.EndRound"}}</button>{{/if}}
</div>
{{#if inFlurry}}<div class="gc-apply"><label>{{localize "GCC.MA.Tournament.Fought"}} <input type="number" min="0" max="{{phaseLeft}}" value="{{fought}}" data-addon-card-input="fought"></label></div>{{/if}}
